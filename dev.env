# Local development config for the Hardhat node (blockchain/: `npm run dev`).
# These are the public Hardhat dev keys from the mnemonic
# "test test test test test test test test test test test junk".
# They are identical on every machine and every node restart.
# NEVER use them on a real network: funds sent there are stolen instantly.

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deterministic: first deployment by account #0 on a fresh node.
OFFBALANCE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
OFFBALANCE_DEPLOYMENT=blockchain/deployments/localhost.json

# Account #0: deployer, which becomes the contract's `server`
SERVER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SERVER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Account #1: job submitter / buyer
