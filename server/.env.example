MONGODB_URI=mongodb://127.0.0.1:27017/offbalance
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
# Explicit database-only development; unset to use the deployed contract.
CHAIN=off
RPC_URL=http://127.0.0.1:8545
# SERVER_PRIVATE_KEY=<local server key from ../dev.env>
# DEPLOYMENT_FILE=/absolute/path/to/blockchain/deployments/localhost.json
# npm run cert:dev generates the default local certificate/key in .local/tls/.
# For an existing certificate, provide BOTH paths:
# TLS_KEY_FILE=/absolute/path/to/key.pem
# TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# Dockerfile builds require a registry namespace and push credentials.
# REGISTRY_NAMESPACE=your-org
# REGISTRY=ghcr.io
# REGISTRY_USERNAME=your-user
# REGISTRY_TOKEN=your-token
