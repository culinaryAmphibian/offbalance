# Copy to .env on EVERY machine (host and clients): cp .env.example .env
# docker-compose.yml reads it. See HOW_TO_RUN_WITH_DOCKER.md §2.

# Required. The host machine's CURRENT LAN IP. Same value on every machine, the host included:
# the host's server writes it into its TLS certificate, so a stale value here on the host breaks
# every client ("IP address mismatch"). Check it on the host before each start:
#   Linux: hostname -I        macOS: ipconfig getifaddr en0
# Replace this example; don't copy it.
HOST_ADDRESS=192.168.1.20

# Optional, client machines only: skip the provider client's prompts.
# Both come from the UI (Provider setup), and both stop working whenever the host restarts
# (fresh database and fresh chain). Then they cause "401 Unauthorized" and "isn't authorized
# for any wallet". Delete them after a host restart, or replace them with new ones.
# OFFBALANCE_API_KEY=
# OFFBALANCE_SESSION_KEY=
